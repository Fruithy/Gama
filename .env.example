# ─────────────────────────────────────────────────────────────
# FILTER ARCADE environment variables
# Copy to .env.local and fill in. Nothing here is required for
# local development: without DATABASE_URL the app runs on an
# embedded PGlite (Postgres-in-WASM) database stored in .data/.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical URLs, share links, OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────
# Production: Supabase Postgres connection string. Use the pooler
# (transaction mode, port 6543) on serverless hosts.
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Local PGlite directory (ignored when DATABASE_URL is set).
# Use "memory://" for a throwaway in-memory database.
PGLITE_DATA_DIR=.data/pglite
# Seed development data automatically when the local DB is empty.
AUTO_SEED=true

# ── Sessions / security ──────────────────────────────────────
# REQUIRED in production. 32+ random bytes, e.g. `openssl rand -base64 48`
SESSION_SECRET=dev-only-insecure-session-secret-change-me
# Admin bootstrap secret for /admin (in addition to profiles.role = 'admin').
ADMIN_SECRET=dev-admin
# Comma-separated usernames that are auto-promoted to admin on sign-in.
ADMIN_USERNAMES=

# ── Supabase Auth (optional; enables email / Google / Apple sign-in) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the browser. Used for account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# ── Camera games (MediaPipe) ─────────────────────────────────
# Override to self-host the MediaPipe WASM runtime + face model.
NEXT_PUBLIC_MEDIAPIPE_WASM_URL=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@1.0.1/wasm
NEXT_PUBLIC_MEDIAPIPE_FACE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task
